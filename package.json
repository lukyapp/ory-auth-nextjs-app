{
  "name": "ory-auth-nextjs-workspace",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm --filter app build",
    "dev": "pnpm --filter app dev",
    "format": "pnpm recursive --if-present run format",
    "format:check": "pnpm recursive --if-present run format:check",
    "lint": "pnpm --filter app lint",
    "prettier": "pnpm recursive --if-present run prettier",
    "start": "pnpm --filter app start",
    "typecheck": "pnpm --filter app typecheck"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  }
}
