# Required
# Default: none, must be set
NEXT_PUBLIC_ORY_SDK_URL=http://localhost:4433

# Required
# Default: none, must be set
ORY_SDK_URL=http://localhost:4433

# Optional
# Default: ORY_SDK_URL with port 4434 when ORY_SDK_URL uses port 4433
ORY_ADMIN_URL=http://localhost:4434

# Required
# Default: none, must be set
ORY_HYDRA_ADMIN_URL=http://localhost:4445

# Required server-only secret used to sign auth intents and encrypt account history
# Generate with: openssl rand -base64 32
AUTH_FLOW_SECRET=replace-with-at-least-32-random-characters

# Required in production
# Must be the public URL served by Dokploy in production
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Optional
# Default: https://oauth.dhe.ovh
ORY_HYDRA_PUBLIC_URL=http://localhost:4444

# Optional
# Default: none, must be set when using SAML or OIDC project API operations
ORY_PROJECT_API_TOKEN=

# Optional
# Default: /
NEXT_PUBLIC_DEFAULT_REDIRECT_URL=https://localhost:5174
